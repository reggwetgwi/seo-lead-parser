# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
# Несколько ключей для ротации при исчерпании квоты:
# GEMINI_API_KEYS=key1,key2,key3

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# --- HH.ru OAuth ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_REDIRECT_URI=http://localhost:8000/callback

# --- Прочее ---
DATABASE_URL=sqlite+aiosqlite:///leads.db
PARSE_INTERVAL_MINUTES=60
MIN_SCORE_TO_NOTIFY=7
